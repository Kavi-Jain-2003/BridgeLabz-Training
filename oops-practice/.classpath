<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" path="gcr-codebase/class-and-object"/>
	<classpathentry kind="src" path="gcr-codebase/constructors-instance-class-accessmodifiers"/>
	<classpathentry kind="src" path="gcr-codebase/encapsulation-and-polymorphism"/>
	<classpathentry kind="src" path="gcr-codebase/inheritance"/>
	<classpathentry kind="src" path="gcr-codebase/this-static-final"/>
	<classpathentry kind="src" path="leet-code-codebase"/>
	<classpathentry kind="src" path="scenerio-based/ecommerceSystem"/>
	<classpathentry excluding="ecommerceSystem/" kind="src" path="scenerio-based"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
