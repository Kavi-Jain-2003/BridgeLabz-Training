public class OverrideExample
{
	public void makeSound()
	{
		System.out.println("Animal sound");
		}
}
class Dog extends Animal
{
	@Override
	public void makeSound()
	{
		System.out.println("Dog sound");
	}
}
public class OverrideExample
{
	public static void main(String[] args)
	{
		Animal a=new Dog;
		a.makeSound();
	}
}
